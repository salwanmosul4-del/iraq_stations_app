rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /stations/{stationId} {
      // القراءة متاحة للجميع
      allow read: if true;

      // إضافة محطة من التطبيق: مستخدم مسجّل (مجهول) + بيانات صحيحة + داخل حدود العراق + محافظة معروفة
      // (نفس الأرقام الموجودة في lib/config.dart).
      // الاستيراد الجماعي من سكربت tools/import_osm_stations.py يتم بصلاحيات المشرف ولا يمر من هنا.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['name', 'area', 'governorate', 'lat', 'lng', 'status', 'queueCars',
              'fuels', 'reportsCount', 'source', 'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.area is string
        && request.resource.data.area.size() <= 80
        && request.resource.data.governorate in
             ['الأنبار', 'أربيل', 'البصرة', 'بابل', 'بغداد', 'دهوك', 'ديالى', 'ذي قار', 'كربلاء', 'كركوك', 'ميسان', 'المثنى', 'النجف', 'نينوى', 'القادسية', 'صلاح الدين', 'السليمانية', 'واسط']
        && request.resource.data.lat is number
        && request.resource.data.lat > 28.9
        && request.resource.data.lat < 37.5
        && request.resource.data.lng is number
        && request.resource.data.lng > 38.7
        && request.resource.data.lng < 48.8
        && request.resource.data.status == 'unknown'
        && request.resource.data.queueCars == null
        && request.resource.data.fuels == []
        && request.resource.data.reportsCount == 0
        && request.resource.data.source == 'user'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // بلاغ عن الحالة: يُسمح بتغيير هذه الحقول فقط، وبزيادة العدّاد بواحد.
      // المحطة المغلقة: بلا طابور وبلا وقود.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['status', 'queueCars', 'fuels', 'updatedAt', 'reportsCount'])
        && request.resource.data.status in ['open', 'closed']
        && (request.resource.data.queueCars == null
            || (request.resource.data.queueCars is int
                && request.resource.data.queueCars >= 0
                && request.resource.data.queueCars <= 500))
        && request.resource.data.fuels is list
        && request.resource.data.fuels.size() <= 3
        && request.resource.data.fuels.hasOnly(['regular', 'premium', 'super'])
        && (request.resource.data.status == 'open'
            || (request.resource.data.queueCars == null
                && request.resource.data.fuels.size() == 0))
        && request.resource.data.reportsCount == resource.data.reportsCount + 1
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
